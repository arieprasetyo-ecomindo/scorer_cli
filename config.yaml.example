# Configuration for Jev + LLM Hackathon Scorer
# Copy to config.yaml and fill in your API credentials

# Jev (TypeSafe) — structured scoring
typesafe:
  # API key from TypeSafe dashboard (store in env var or .env)
  api_key_env: "TYPESAFE_API_KEY"

  # TypeSafe API endpoint (typesafe-sdk's own default; only set this if self-hosting)
  api_endpoint: "https://api.typesafe.ai"

  # Model selection. Must be "jev-latest" (or a pinned version like "jev-1.13.0") -
  # the real typesafe-sdk rejects the bare name "jev" as an unknown model.
  model: "jev-latest"

  # Retry policy for Jev API calls
  max_retries: 1
  retry_delay_seconds: 2

# Claude (Anthropic) — report generation (prose only)
report_generation:
  # API key from Anthropic console (store in env var or .env)
  api_key_env: "ANTHROPIC_API_KEY"

  # Claude model for writing markdown justifications
  # Use claude-opus-5 for best quality, claude-haiku for cost
  model: "claude-opus-5"

  # Temperature: keep low for consistent, factual writing
  temperature: 0.3

  # Max tokens for generated report (includes all dimensions + summary)
  max_tokens: 2000

  # Retry policy
  max_retries: 1
  retry_delay_seconds: 2

# Weighting for final combined score
weights:
  # Structure (code quality) vs. Spec (SDD quality)
  structure: 0.5
  spec: 0.5

# Structure rubric scoring anchors
# Maps Score levels (1–5) to human-readable descriptions for justifications
structure_rubric:
  coupling:
    level_1: "Critical — pervasive high coupling; most nodes densely interconnected"
    level_2: "Poor — several god-modules; high fan-in/out hotspots"
    level_3: "Fair — one or two hotspot nodes; moderate interdependencies"
    level_4: "Good — isolated hotspots; mostly even coupling"
    level_5: "Excellent — low, even coupling; no architectural hotspots"

  circular_dependencies:
    level_1: "Critical — many cycles (>6) spanning major modules"
    level_2: "Poor — 4–6 cycles or cycles involving core modules"
    level_3: "Fair — 2–3 cycles, isolated to non-core areas"
    level_4: "Good — 1 isolated cycle"
    level_5: "Excellent — zero cycles"

  dependency_depth:
    level_1: "Critical — spaghetti-like; no clear layering"
    level_2: "Poor — excessively deep chains relative to project size"
    level_3: "Fair — notably deep chains; some layering present"
    level_4: "Good — reasonable depth; shallow overall structure"
    level_5: "Excellent — shallow, flat structure appropriate to size"

  cyclomatic_complexity:
    level_1: "Critical — avg CCN >> 15; many complex functions (>25% above threshold)"
    level_2: "Poor — avg CCN > 12 or >15% of functions above threshold"
    level_3: "Fair — avg CCN 7–12 or 5–15% above threshold"
    level_4: "Good — avg CCN 4–7; few complex functions (<5%)"
    level_5: "Excellent — avg CCN ≤ 4; no complex functions"

  function_size_discipline:
    level_1: "Critical — avg NLOC >> 100 or avg params >> 8"
    level_2: "Poor — avg NLOC > 70 or avg params > 6"
    level_3: "Fair — avg NLOC 40–70 or avg params 4–6"
    level_4: "Good — avg NLOC 20–40 or avg params 3–4"
    level_5: "Excellent — avg NLOC ≤ 20 and avg params ≤ 3"

  betweenness_centrality:
    level_1: "Critical — severe architectural bottleneck (max/avg > 30×)"
    level_2: "Poor — pronounced bottleneck (max/avg 15–30× or multiple nodes 10×+)"
    level_3: "Fair — some centrality (max/avg 6–15×)"
    level_4: "Good — modest centrality (max/avg 3–6×; plausible entry points)"
    level_5: "Excellent — no bottlenecks; evenly distributed (max/avg < 3×)"

# Spec rubric scoring
# Noul thresholds map yes/no answers to score ranges
spec_rubric:
  clarity_testability:
    threshold: 0.65  # Jev confidence above this → "yes" confidence
    yes_score_range: [7.5, 9.0]  # If yes
    no_score_range: [1.0, 4.0]   # If no

  scope_boundary:
    threshold: 0.60
    yes_score_range: [7.5, 9.0]
    no_score_range: [1.0, 4.0]

  internal_consistency:
    threshold: 0.70
    yes_score_range: [7.5, 9.0]
    no_score_range: [1.0, 4.0]

  traceability:
    threshold: 0.65
    yes_score_range: [7.5, 9.0]
    no_score_range: [1.0, 4.0]

  substance_over_polish:
    threshold: 0.60
    yes_score_range: [7.5, 9.0]
    no_score_range: [1.0, 4.0]

# Scoring rule anchors for dimension descriptions
spec_dimensions:
  clarity_testability:
    description: "Requirements are concrete and testable"
    good: ">80% of requirements are specific and falsifiable"
    bad: "Vague requirements like 'handle errors well' without criteria"

  scope_boundary:
    description: "In-scope and out-of-scope are clearly defined"
    good: "Explicit list: 'MVP: A, B, C. Not in scope: X, Y, Z.'"
    bad: "Unclear whether features are MVP or future; must guess"

  internal_consistency:
    description: "Spec does not contradict itself"
    good: "Data models and requirements align throughout"
    bad: "Same feature described differently in different sections"

  traceability:
    description: "Spec structure maps to codebase modules"
    good: ">70% of codebase files mentioned or clearly accounted for"
    bad: "Spec describes different system; many files unexplained"

  substance_over_polish:
    description: "Spec prioritizes content over formatting"
    good: "Concrete detail regardless of formatting"
    bad: "Well-formatted but vague; buzzwords without specifics"

# Red flag thresholds
red_flags:
  # Structural
  circular_deps_involving_more_than: 3  # Flag if any cycle touches > N modules
  max_ccn_threshold: 20                  # Flag if any function CCN > N
  fan_coupling_multiple: 5.0              # Flag if any node fan-in/out > N× avg
  betweenness_multiple: 10.0              # Flag if any node betweenness > N× avg

  # Spec-related
  min_modules_mentioned: 2                # Flag if < N codebase_modules mentioned
  choice_confidence_low: 0.45             # Flag if weakest_dimension confidence < N
  templated_boilerplate: true             # Check for [TODO], [description here], etc.

# Batch processing
batch:
  # Stop on first error (true) or continue and log errors (false)
  fail_fast: false

  # Whether to write intermediate metrics.json files alongside reports
  write_metrics: true

# Logging
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "scorer.log"
